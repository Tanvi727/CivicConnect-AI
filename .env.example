# Copy this file to ".env" and change the values.

# Port the website and API run on
PORT=3000

# Use 0.0.0.0 to open the site from your phone on the same Wi-Fi
HOST=127.0.0.1

# The administrator account is created on first start
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@civicconnect.local
ADMIN_PASSWORD=ChangeThisPassword123

# Secret used to sign login tokens (16+ characters).
# Leave empty to generate one automatically.
JWT_SECRET=

# Days a login stays valid
TOKEN_TTL_DAYS=7

# Folder (inside the project) for the database and uploaded photos
DATA_DIR=data
